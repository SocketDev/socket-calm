        "storage.type.function.arrow",
        "variable",
        "variable.other",
        "variable.other.readwrite",
        "variable.other.object",
        "variable.other.constant.object",
        "variable.parameter",
        "meta.definition.variable.name",
        "meta.array.literal",
        "meta.object.member",
        "support.variable.dom",
        "entity.name.label"
