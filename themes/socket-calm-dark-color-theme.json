    "function": "#8fb8f2",
    "method": "#8fb8f2",
    "decorator": "#d29af7",
    "macro": "#f0a878",
    "variable": "#f5f5fa",
    "parameter": "#f5f5fa",
    "property": "#bb72ee",
    "enumMember": "#ff5fbd",
    "event": "#e8c07a",
    "label": "#f5f5fa",
    "selfKeyword": "#d29af7",
    "builtinConstant": "#ff5fbd",
    "*.readonly": "#f5f5fa",
    "*.defaultLibrary": "#8ad3cb",
    "variable.defaultLibrary": "#8ad3cb",
    "function.defaultLibrary": "#8fb8f2",
