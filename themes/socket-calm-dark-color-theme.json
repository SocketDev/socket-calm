      "settings": { "foreground": "#d29af7" }
    },
    {
      "name": "Preprocessor directives",
      "scope": [
        "meta.preprocessor",
        "keyword.control.directive",
        "entity.name.function.preprocessor",
        "punctuation.definition.directive"
      ],
      "settings": { "foreground": "#d29af7" }
    },
    {
      "name": "Rust lifetimes and macros",
      "scope": [
        "storage.modifier.lifetime.rust",
        "entity.name.lifetime.rust",
        "punctuation.definition.lifetime.rust",
        "support.function.macro.rust",
        "entity.name.function.macro.rust"
      ],
      "settings": { "foreground": "#f0a878" }
    },
    {
      "name": "Go package and struct tags",
      "scope": ["entity.name.package.go", "string.quoted.raw.go"],
      "settings": { "foreground": "#8ad3cb" }
    },
    {
      "name": "Python decorators and self",
      "scope": [
        "entity.name.function.decorator.python",
        "meta.function.decorator.python",
        "variable.parameter.function.language.special.self.python",
        "variable.language.special.self.python"
      ],
      "settings": { "foreground": "#d29af7" }
    },
    {
      "name": "Environment files",
      "scope": ["source.env variable", "keyword.other.definition.ini"],
      "settings": { "foreground": "#bb72ee" }
    },
    {
      "name": "Git commit and ignore",
      "scope": [
        "meta.scope.metadata.diff",
        "meta.scope.subject.diff",
        "text.git-commit meta.scope.metadata"
      ],
      "settings": { "foreground": "#9278a1" }
    },
    {
      "name": "Bold italic combinations",
      "scope": ["markup.bold markup.italic", "markup.italic markup.bold"],
      "settings": { "fontStyle": "bold italic" }
    }
  ],
  "semanticTokenColors": {
    "comment": { "foreground": "#7e7e91", "fontStyle": "italic" },
    "string": "#97e0af",
    "keyword": "#d29af7",
    "number": "#ff5fbd",
    "regexp": "#f0a878",
    "operator": "#f5f5fa",
    "namespace": "#8ad3cb",
    "type": "#8ad3cb",
    "struct": "#8ad3cb",
    "class": "#8ad3cb",
    "interface": "#8ad3cb",
    "enum": "#8ad3cb",
